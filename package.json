{
  "name": "the-turing-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "bun --bun run vite",
    "build": "bun --bun run vite build",
    "start": "bun src/server/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run build",
    "test:e2e": "bun scripts/e2e.ts",
    "format": "bun scripts/format.ts",
    "format:check": "bun scripts/format.ts --check",
    "sim:extract": "bun scripts/sim/extract.ts",
    "review": "bun --bun run vite --port 5174",
    "review:capture": "bun scripts/review-capture.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "skills": "1.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
